    "*.{scss,json,md}": "prettier --write"
  },
  "dependencies": {
    "@lucide/vue": "^1.16.0",
    "@mozilla/readability": "^0.6.0",
    "@nuxt/image": "^2.0.0",
    "@nuxtjs/i18n": "^10.4.0",
    "@pinia/nuxt": "^0.11.3",
    "@primeuix/themes": "^2.0.3",
    "@primevue/nuxt-module": "^4.5.5",
    "@vueuse/core": "^14.3.0",
    "ky": "^2.0.2",
    "linkedom": "^0.18.12",
    "nuxt": "^4.4.6",
    "pinia": "^3.0.4",
    "primevue": "^4.5.5",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@nuxtjs/color-mode": "^4.0.0",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "sass": "^1.100.0"
  }
